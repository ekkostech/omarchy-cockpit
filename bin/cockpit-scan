#!/usr/bin/env python3
# cockpit-scan: everything Cockpit shows, as one JSON document on stdout.
#   repos:     every git repo under the scan roots (and any folder a terminal is in),
#              with its worktrees, branches and status
#   terminals: terminal windows (Hyprland) with the folder their shell is in
# Usage: cockpit-scan [--root DIR]... [--max-depth N]
#
# Window titles and other private data only ever travel through pipes and
# /proc, never through command-line arguments, which other local users can read.
import json, os, subprocess, sys, time

def run(args, timeout=20):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""

def main():
    roots, depth = [], 3
    argv = sys.argv[1:]
    while argv:
        a = argv.pop(0)
        if a == "--root" and argv: roots.append(argv.pop(0))
        elif a == "--max-depth" and argv: depth = int(argv.pop(0))
    home = os.path.expanduser("~")
    roots = roots or [os.path.join(home, d) for d in ("Projects", "code", "src", "dev", "Work")]

    # --- terminals: window -> pty -> shell pid -> cwd ---------------------------
    try: clients = json.loads(run(["hyprctl", "-j", "clients"]) or "[]")
    except json.JSONDecodeError: clients = []
    kids = {}
    for line in run(["ps", "-e", "-o", "pid=,ppid=,tty="]).splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[2].startswith("pts/"):
            kids.setdefault(parts[1], []).append((parts[0], parts[2]))
    terminals = []
    for w in clients:
        if not isinstance(w, dict) or w.get("mapped") is False or not isinstance(w.get("pid"), int) or w["pid"] <= 0: continue
        shells = kids.get(str(w["pid"]), [])
        if len(shells) != 1: continue
        shell_pid, pty = shells[0]
        try: cwd = os.readlink(f"/proc/{shell_pid}/cwd")
        except OSError: cwd = ""
        title = str(w.get("title", ""))
        ws = w.get("workspace") or {}
        terminals.append({
            "address": w.get("address", ""), "pid": str(w["pid"]), "shellPid": shell_pid, "pty": pty,
            "title": title, "class": w.get("class", ""), "workspace": ws.get("name") or str(ws.get("id", "")),
            "focused": w.get("focusHistoryID") == 0, "cwd": cwd,
            "agent": "working" if title[:1] in "◐◑◒◓" else "idle" if title[:1] == "✳" else "other",
        })

    # --- repos ---------------------------------------------------------------------
    def git(path, *args):
        return run(["git", "-C", path, *args]).strip()
    def main_worktree(path):
        top = git(path, "rev-parse", "--show-toplevel")
        if not top: return None
        common = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir") or ""
        if common.endswith("/.git"): common = common[:-5]
        return git(common, "rev-parse", "--show-toplevel") or top if common else top
    seen, repos = set(), []
    def add(path):
        main = main_worktree(path)
        if main and main not in seen: seen.add(main); repos.append(main)
    for root in roots:
        if not os.path.isdir(root): continue
        base = root.rstrip("/").count("/")
        for dirpath, dirnames, filenames in os.walk(root):
            if dirpath.count("/") - base >= depth: dirnames[:] = []
            dirnames[:] = [d for d in dirnames if d not in (".ekkos-worktrees", "node_modules", ".git")]
            if os.path.exists(os.path.join(dirpath, ".git")): add(dirpath); dirnames[:] = []
    for t in terminals:
        if t["cwd"]: add(t["cwd"])

    def worktrees(main):
        out, wt = [], None
        for line in (run(["git", "-C", main, "worktree", "list", "--porcelain"]) + "\n").splitlines():
            if line.startswith("worktree "): wt = {"path": line[9:], "branch": "", "head": ""}
            elif line.startswith("HEAD ") and wt: wt["head"] = line[5:12]
            elif line.startswith("branch ") and wt: wt["branch"] = line[7:].replace("refs/heads/", "", 1)
            elif line == "" and wt:
                p = wt["path"]
                dirty = len([l for l in run(["git", "-C", p, "status", "--porcelain"]).splitlines() if l])
                upstream = git(p, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
                ahead = behind = None
                if upstream:
                    counts = git(p, "rev-list", "--left-right", "--count", f"{upstream}...HEAD").split()
                    if len(counts) == 2: behind, ahead = int(counts[0]), int(counts[1])
                age = git(p, "log", "-1", "--format=%ct")
                wt.update({"dirty": dirty, "ahead": ahead, "behind": behind, "upstream": upstream,
                           "lastCommit": int(age) if age.isdigit() else 0, "main": p == main})
                out.append(wt); wt = None
        return out
    repo_list = [{"path": m, "name": os.path.basename(m), "remote": git(m, "remote", "get-url", "origin"), "worktrees": worktrees(m)} for m in repos]

    json.dump({"now": int(time.time()), "repos": repo_list, "terminals": terminals}, sys.stdout, separators=(",", ":"))
    print()

if __name__ == "__main__":
    main()
